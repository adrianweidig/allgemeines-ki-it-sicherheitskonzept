@startuml
skinparam dpi 180
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam defaultFontColor #17324D
skinparam ArrowColor #536D82
skinparam ArrowFontColor #334E64
skinparam ArrowFontSize 13
skinparam ArrowThickness 1.5
skinparam roundCorner 12
skinparam nodesep 24
skinparam ranksep 26
skinparam rectangle {
  BackgroundColor #F2F6FA
  BorderColor #738A9E
}
rectangle "<color:#FFFFFF><b>01  KI-Szenario bestimmen</b></color>\n<color:#FFFFFF>Ursache · betroffene Informationen · Auswirkungen</color>" as szenario #17324D
rectangle "<b>02  Ausgangsrisiko bewerten</b>\nEintrittshäufigkeit × Schadenshöhe" as ausgang
rectangle "<b>03  Maßnahmen berücksichtigen</b>\nKI-spezifische Schutzgrenzen\nRestrisiko bewerten" as massnahmen #E5F3F1
card "<b>Restrisiko akzeptabel?</b>\nEntscheidung im geltenden Zuständigkeitsrahmen" as entscheidung #FFF4DC
rectangle "<b>Betroffene KI-Funktion begrenzen</b>\nBehandlung und erneute Bewertung" as behandlung #FCECEE
rectangle "<color:#FFFFFF><b>04  Bewertung fortschreiben</b></color>\n<color:#FFFFFF>Bei Änderungen oder neuen Erkenntnissen</color>" as nachhalten #17324D
szenario -down-> ausgang
ausgang -down-> massnahmen
massnahmen -down-> entscheidung
entscheidung -right-> behandlung : nein
entscheidung -down-> nachhalten : ja
behandlung -up-> massnahmen
@enduml
