@startuml
skinparam dpi 180
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #446B8C
skinparam activity {
  BackgroundColor #E8EEF5
  BorderColor #7890A5
  FontColor #203040
}
skinparam rectangle {
  BackgroundColor #E8EEF5
  BorderColor #7890A5
  FontColor #203040
}
start
:Szenario und Annahmen\nUrsache · betroffener Wert · Schaden;
:Ausgangsrisiko\nEintrittshäufigkeit × Schadenshöhe;
:Geeignete Maßnahmen\nWirkung begründen und Restrisiko bewerten;
if (Akute Gefahr, unzulässige Nutzung,\nfehlende Rechte oder KI-Abhängigkeit?) then (ja)
  :Betroffene Funktion sperren\nKeine Ausnahme;
  stop
else (nein)
endif
if (Restrisiko hoch oder sehr hoch?) then (ja)
  :Sperre oder genehmigter\nbefristeter Ausnahmebetrieb\nZusatzmaßnahmen\nund Abbruchkriterien;
else (nein)
  :Begründete Akzeptanz\nim Unternehmensrahmen;
endif
:Risiko, Entscheidung und Nachweise führen\nVerantwortung und Prüftermin\nWesentliche Änderungen erneut bewerten;
:Nicht betroffene Arbeit bleibt möglich;
stop
@enduml
