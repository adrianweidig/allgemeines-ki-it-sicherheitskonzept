@startuml
skinparam dpi 180
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #446B8C
skinparam activity {
  BackgroundColor #E8EEF5
  BorderColor #7890A5
  FontColor #203040
}
skinparam rectangle {
  BackgroundColor #E8EEF5
  BorderColor #7890A5
  FontColor #203040
}
start
:Modell schlägt Aktion vor;
if (Auftrag, Profil oder Rechte verletzt?) then (ja)
  :Aktion blockieren;
  stop
else (nein)
endif
if (Kritisch, privilegiert, irreversibel?\nOder destruktiv / Löschung ohne\neinfache Wiederherstellung oder\nmit erheblichem Schadenspotenzial?) then (ja)
  if (Konkrete Genehmigung erteilt?) then (nein)
    :Aktion blockieren;
    stop
  else (ja)
  endif
else (nein)
  :Routineaktion\nOhne Einzelgenehmigung;
endif
:Ausführung im genehmigten Umfang\nWiederherstellung umfasst auch Folgen;
:Entscheidung und Ergebnis\ndatensparsam zuordnen;
stop
@enduml
