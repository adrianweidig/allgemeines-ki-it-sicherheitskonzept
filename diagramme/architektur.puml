@startuml
skinparam dpi 180
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam defaultFontColor #17324D
skinparam ArrowColor #536D82
skinparam ArrowFontSize 12
skinparam ArrowThickness 1.5
skinparam roundCorner 12
skinparam nodesep 24
skinparam ranksep 26
skinparam rectangle {
  BackgroundColor #F2F6FA
  BorderColor #738A9E
}
skinparam package {
  BackgroundColor #F7FAFC
  BorderColor #738A9E
}
rectangle "<b>Dateien außerhalb der Umgebung</b>\nModelle und benötigte Daten" as eingang #EAF2F8
rectangle "<b>Bestehendes Übernahmeverfahren</b>\nGeregelte Dateiübernahme" as schleuse #FFF4DC
package "Air-Gap-Umgebung · keine Internetverbindung" {
 rectangle "<b>KI-Anwendungen</b>\nChat und Projektassistent\nIndividuelle Nutzerrechte" as app
 rectangle "<b>Interne Modellbereitstellung</b>\nFreigegebene Modelle\nKeine externen Ausweichziele" as model #E5F3F1
 rectangle "<b>Interne Dokumentverarbeitung</b>\nAufbereitung und Wissenssuche\nQuellrechte bleiben wirksam" as daten
 app -down-> model : Anfrage und Kontext
 daten -up-> app : berechtigte Ausschnitte
}
eingang -down-> schleuse
schleuse ..> daten : Dateiübernahme
note bottom of daten
Gestrichelt: Dateiübernahme,
keine Netzwerkverbindung
end note
@enduml
