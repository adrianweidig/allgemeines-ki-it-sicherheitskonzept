@startuml
skinparam dpi 180
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #446B8C
skinparam activity {
  BackgroundColor #E8EEF5
  BorderColor #7890A5
  FontColor #203040
}
skinparam rectangle {
  BackgroundColor #E8EEF5
  BorderColor #7890A5
  FontColor #203040
}
rectangle "VERWALTETE CLIENTS\nUnternehmensanmeldung\nFreigegebene Arbeitsbereiche" as client
rectangle "KONTROLLIERTER KI-ZUGANG\nIdentität · Rechte · Profile\nKeine direkten Umgehungswege" as gateway
rectangle "UNTERNEHMENSDIENSTE\nIdP · Daten · Entwicklung\nBestehende IT-Regeln" as support
rectangle "LOKALE KI BEVORZUGT\nServer oder Endgerät\nWissenssuche optional" as lokal
rectangle "OPTION: EXTERNE KI\nStandardmäßig aus\nZusätzliche KI-Freigabe" as extern #FFF2CC
rectangle "WEITERARBEIT OHNE KI\nJede Tätigkeit bleibt möglich\nNormale Reparaturverfahren" as weiter #EAF2EA
client -down-> gateway
gateway -right-> support
gateway -down-> lokal
lokal -[hidden]right-> extern
gateway -down-> extern : nur freigegeben
lokal -down-> weiter : KI-Ausfall
@enduml
